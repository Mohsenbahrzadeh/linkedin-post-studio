    },
    {
      "$kind": "custombox",
      "Header": "The result",
      "Body": "",
      "BulletsText": "DbSet\u003CT\u003E is the repository, DbContext the unit of work\nLess code, better-optimized queries\nTests exercise real SQL with Testcontainers",
