    {
      "$kind": "custombox",
      "Header": "What the abstraction cost us",
      "Body": "",
      "BulletsText": "8 nearly identical repository methods\nIt loaded whole entities (no Select into a DTO)\nMocked tests that proved nothing real\nA layer that just forwarded to DbContext",
      "Marker": "CrossCircle",
      "Glyph": "\u274C",
      "Bg": "#FDECEA",
