      "$kind": "problem",
      "Header": "Without a key",
      "Intro": "Every retry is treated as a brand new request.",
      "RowsText": "POST /orders | \u2192 order #1\nPOST /orders (retry) | \u2192 order #2\nPOST /orders (retry) | \u2192 order #3",
      "BulletsText": "One click, three orders\nNo error anywhere\nSupport finds out first",
      "Dir": "Auto",
      "TextScale": 1,
      "Id": "299e17b8accd439799fbb97821ec295f",
