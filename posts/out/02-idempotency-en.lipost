    },
    {
      "$kind": "solution",
      "Header": "With an Idempotency-Key",
      "Intro": "The client reuses one key for every retry of the same intent.",
      "CodeLinesText": "Idempotency-Key: 7b1c\u2026 | // same key\nOrder #1 | // returned 3\u00D7",
      "BulletsText": "Safe to retry\nStored response is replayed\nWorks for payments too",
