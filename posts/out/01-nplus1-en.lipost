    {
      "$kind": "solution",
      "Header": "One projected query",
      "Intro": "Select only what the endpoint returns.",
      "CodeLinesText": "1 query | // not 201\nCPU 95% | // now 18%",
      "BulletsText": "No lazy loading\nNo scale-up needed\nQuery count asserted in tests",
      "Dir": "Auto",
