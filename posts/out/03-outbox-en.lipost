    {
      "$kind": "solution",
      "Header": "Transactional outbox",
      "Intro": "Write the event next to the data, publish it afterwards.",
      "CodeLinesText": "Orders \u002B OutboxMessages | // one transaction\nWorker \u2192 Broker | // publishes later",
      "BulletsText": "Atomic write\nAt-least-once delivery\nConsumers stay idempotent",
      "Dir": "Auto",
      "TextScale": 1,
