      "$kind": "problem",
      "Header": "Dual write",
      "Intro": "Two systems, two commits, a crash in between.",
      "RowsText": "SaveChangesAsync() | \u2705\nbus.Publish(event) | \uD83D\uDCA5",
      "BulletsText": "Order saved, event lost\nConfirmation email never sent\nSystems silently drift apart",
