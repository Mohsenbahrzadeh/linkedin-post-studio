    {
      "$kind": "custombox",
      "Header": "The problem with throwing",
      "Body": "",
      "BulletsText": "Control flow hidden in try/catch\nThe failure isn\u0027t in the signature\nEasy to forget to catch it\nExpensive on hot paths",
      "Marker": "CrossCircle",
      "Glyph": "\u274C",
      "Bg": "#FDECEA",
