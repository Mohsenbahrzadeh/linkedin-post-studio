    },
    {
      "$kind": "custombox",
      "Header": "Why Result",
      "Body": "",
      "BulletsText": "Expected failures live in the return type\nCallers must handle success and error\nCompose with Map / Bind, no surprises",
      "Marker": "CheckCircle",
      "Glyph": "\u2705",
      "Bg": "#E9F5EC",
