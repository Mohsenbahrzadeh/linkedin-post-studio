    {
      "$kind": "custombox",
      "Header": "\u0646\u062A\u06CC\u062C\u0647",
      "Body": "",
      "BulletsText": "DbSet\u003CT\u003E \u0647\u0645\u0627\u0646 \u0631\u06CC\u067E\u0627\u0632\u06CC\u062A\u0648\u0631\u06CC \u0627\u0633\u062A \u0648 DbContext \u0647\u0645\u0627\u0646 Unit of Work\n\u06A9\u062F \u06A9\u0645\u062A\u0631 \u0648 \u06A9\u0648\u0626\u0631\u06CC\u200C\u0647\u0627\u06CC \u0628\u0647\u06CC\u0646\u0647\u200C\u062A\u0631\n\u062A\u0633\u062A\u200C\u0647\u0627 SQL \u0648\u0627\u0642\u0639\u06CC \u0631\u0627 \u0628\u0627 Testcontainers \u0627\u062C\u0631\u0627 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F",
