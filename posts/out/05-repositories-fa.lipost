    {
      "$kind": "custombox",
      "Header": "\u0627\u0646\u062A\u0632\u0627\u0639 \u0686\u0647 \u0647\u0632\u06CC\u0646\u0647\u200C\u0627\u06CC \u062F\u0627\u0634\u062A",
      "Body": "",
      "BulletsText": "\u06F8 \u0645\u062A\u062F\u0650 \u062A\u0642\u0631\u06CC\u0628\u0627\u064B \u06CC\u06A9\u0633\u0627\u0646 \u062F\u0631 \u06CC\u06A9 \u0631\u06CC\u067E\u0627\u0632\u06CC\u062A\u0648\u0631\u06CC\n\u06A9\u0644 \u0627\u0646\u062A\u06CC\u062A\u06CC \u0631\u0627 \u0645\u06CC\u200C\u062E\u0648\u0627\u0646\u062F (\u0628\u062F\u0648\u0646 Select \u0628\u0647 DTO)\n\u062A\u0633\u062A\u200C\u0647\u0627\u06CC Mock \u06A9\u0647 \u0647\u06CC\u0686 \u0686\u06CC\u0632 \u0648\u0627\u0642\u0639\u06CC \u0631\u0627 \u0627\u062B\u0628\u0627\u062A \u0646\u0645\u06CC\u200C\u06A9\u0631\u062F\u0646\u062F\n\u0644\u0627\u06CC\u0647\u200C\u0627\u06CC \u06A9\u0647 \u0641\u0642\u0637 \u0628\u0647 DbContext \u0641\u0648\u0631\u0648\u0627\u0631\u062F \u0645\u06CC\u200C\u06A9\u0631\u062F",
      "Marker": "CrossCircle",
