    {
      "$kind": "text",
      "Text": "We realized DbContext already does exactly this. DbSet\u003CT\u003E is a repository and DbContext is the unit of work \u2014 we had put a valueless layer of indirection on top.",
      "FontSize": 16,
      "Bold": false,
      "Color": "#17233F",
      "Font": "pack://application:,,,/Fonts/#Vazirmatn",
      "Dir": "Ltr",
      "Align": "Left",
      "Id": "62afb902df83421a9baec6dcd78e1f0a",
