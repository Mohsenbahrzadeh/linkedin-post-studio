    {
      "$kind": "banner",
      "Text": "\u062F\u06CC\u062A\u0627\u0628\u06CC\u0633 \u0648 Broker \u062A\u0631\u0627\u06A9\u0646\u0634 \u0645\u0634\u062A\u0631\u06A9 \u0646\u062F\u0627\u0631\u0646\u062F. *SaveChanges \u0645\u0648\u0641\u0642 \u0634\u062F\u060C \u0648\u0644\u06CC \u067E\u06CC\u0627\u0645 \u0646\u0631\u0633\u06CC\u062F.*",
