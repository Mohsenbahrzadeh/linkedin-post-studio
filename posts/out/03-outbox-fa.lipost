    {
      "$kind": "flow",
      "NodesText": "API | \u062B\u0628\u062A \u0633\u0641\u0627\u0631\u0634 \u002B \u0631\u062F\u06CC\u0641 Outbox | \uD83D\uDDC4\uFE0F\nWorker | \u062E\u0648\u0627\u0646\u062F\u0646 \u0648 \u0627\u0646\u062A\u0634\u0627\u0631 | \u2699\uFE0F\nBroker | Consumer\u0647\u0627 \u0631\u0648\u06CC\u062F\u0627\u062F \u0631\u0627 \u067E\u0631\u062F\u0627\u0632\u0634 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F | \uD83D\uDCE8",
