    {
      "$kind": "problem",
      "Header": "Dual Write",
      "Intro": "\u062F\u0648 \u0633\u06CC\u0633\u062A\u0645\u060C \u062F\u0648 Commit\u060C \u0648 \u06CC\u06A9 \u06A9\u0631\u0634 \u0628\u06CC\u0646 \u0622\u0646\u200C\u0647\u0627.",
      "RowsText": "SaveChangesAsync() | \u2705\nbus.Publish(event) | \uD83D\uDCA5",
      "BulletsText": "\u0633\u0641\u0627\u0631\u0634 \u062B\u0628\u062A \u0634\u062F \u0648\u0644\u06CC \u0631\u0648\u06CC\u062F\u0627\u062F \u06AF\u0645 \u0634\u062F\n\u0627\u06CC\u0645\u06CC\u0644 \u062A\u0623\u06CC\u06CC\u062F \u0647\u06CC\u0686\u200C\u0648\u0642\u062A \u0646\u0631\u0641\u062A\n\u062F\u0648 \u0633\u06CC\u0633\u062A\u0645 \u0628\u06CC\u200C\u0635\u062F\u0627 \u0646\u0627\u0633\u0627\u0632\u06AF\u0627\u0631 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F",
