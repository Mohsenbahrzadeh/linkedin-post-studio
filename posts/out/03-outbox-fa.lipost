    {
      "$kind": "code",
      "Caption": "EF Core",
      "Code": "db.Orders.Add(order);\ndb.OutboxMessages.Add(new OutboxMessage(new OrderCreated(order.Id)));\nawait db.SaveChangesAsync();   // atomic: the order and its event, or neither",
