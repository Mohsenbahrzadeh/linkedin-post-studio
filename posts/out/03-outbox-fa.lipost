    },
    {
      "$kind": "benefits",
      "CardsText": "\u0627\u062A\u0645\u06CC\u06A9 | \u062F\u0627\u062F\u0647 \u0648 \u0631\u0648\u06CC\u062F\u0627\u062F \u0628\u0627 \u0647\u0645 | \uD83D\uDEE1\uFE0F\n\u0642\u0627\u0628\u0644\u200C\u0627\u0639\u062A\u0645\u0627\u062F | \u0628\u0627 \u06A9\u0631\u0634 \u0647\u06CC\u0686\u200C\u0686\u06CC\u0632 \u06AF\u0645 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F | \uD83D\uDCE6\n\u0633\u0627\u062F\u0647 | \u06CC\u06A9 \u062C\u062F\u0648\u0644 \u0648 \u06CC\u06A9 Worker | \uD83E\uDDE9\n\u0622\u0645\u0627\u062F\u0647 | MassTransit\u060C CAP\u060C Wolverine | \uD83D\uDE80",
