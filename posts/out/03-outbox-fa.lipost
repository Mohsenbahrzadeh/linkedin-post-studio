    {
      "$kind": "solution",
      "Header": "Transactional Outbox",
      "Intro": "\u0631\u0648\u06CC\u062F\u0627\u062F \u0631\u0627 \u06A9\u0646\u0627\u0631 \u062F\u0627\u062F\u0647 \u0628\u0646\u0648\u06CC\u0633 \u0648 \u0628\u0639\u062F\u0627\u064B \u0645\u0646\u062A\u0634\u0631 \u06A9\u0646.",
      "CodeLinesText": "Orders \u002B OutboxMessages | // one transaction\nWorker \u2192 Broker | // publishes later",
      "BulletsText": "\u0646\u0648\u0634\u062A\u0646 \u0627\u062A\u0645\u06CC\u06A9\n\u062A\u062D\u0648\u06CC\u0644 At-least-once\nConsumer\u0647\u0627 Idempotent \u0645\u06CC\u200C\u0645\u0627\u0646\u0646\u062F",
