    },
    {
      "$kind": "code",
      "Caption": "\u0628\u0631\u06AF\u0631\u062F\u0627\u0646\u062F\u0646 Result",
      "Code": "public Result\u003COrder\u003E Get(int id)\n{\n    var order = db.Find(id);\n    return order is null\n        ? Result.Fail(\u0022Order not found\u0022)\n        : Result.Ok(order);\n}",
      "Language": "csharp",
      "FontSize": 14,
      "ShowBadge": true,
      "Id": "d4c890c45f174d53b8084f9c2ab9223a",
      "X": 554,
      "Y": 247,
      "Width": 466,
      "Height": 171,
      "Z": 5,
      "Rotation": 0,
      "Opacity": 1,
      "IsVisible": true,
      "IsLocked": false
    },
    {
      "$kind": "custombox",
      "Header": "\u0645\u0634\u06A9\u0644\u0650 \u067E\u0631\u062A\u0627\u0628 \u0627\u0633\u062A\u062B\u0646\u0627\u0621",
      "Body": "",
      "BulletsText": "\u062C\u0631\u06CC\u0627\u0646 \u06A9\u0646\u062A\u0631\u0644 \u067E\u0646\u0647\u0627\u0646 \u062F\u0631 try/catch\n\u062E\u0637\u0627 \u062F\u0631 \u0627\u0645\u0636\u0627\u06CC \u0645\u062A\u062F \u062F\u06CC\u062F\u0647 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F\n\u0641\u0631\u0627\u0645\u0648\u0634\u200C\u06A9\u0631\u062F\u0646 catch \u0622\u0633\u0627\u0646 \u0627\u0633\u062A\n\u0631\u0648\u06CC \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC \u062F\u0627\u063A \u06A9\u0646\u062F \u0627\u0633\u062A",
