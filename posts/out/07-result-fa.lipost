    {
      "$kind": "text",
      "Text": "\u0627\u0633\u062A\u062B\u0646\u0627\u0621 \u0628\u0631\u0627\u06CC \u0645\u0648\u0627\u0631\u062F \u0627\u0633\u062A\u062B\u0646\u0627\u06CC\u06CC\u061B \u062E\u0637\u0627\u0647\u0627\u06CC \u0645\u0648\u0631\u062F\u0627\u0646\u062A\u0638\u0627\u0631 \u0631\u0627 \u0628\u0647\u200C\u0635\u0648\u0631\u062A \u062F\u0627\u062F\u0647 \u0645\u062F\u0644 \u06A9\u0646.",
