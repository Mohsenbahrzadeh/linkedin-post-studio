    {
      "$kind": "code",
      "Caption": "\u067E\u0631\u062A\u0627\u0628 \u0627\u0633\u062A\u062B\u0646\u0627\u0621",
      "Code": "public Order Get(int id)\n{\n    var order = db.Find(id);\n    if (order is null)\n        throw new NotFoundException(id); // expected!\n    return order;\n}",
      "Language": "csharp",
      "FontSize": 13,
      "ShowBadge": true,
      "Id": "c5c6c06e05c841da937d69f67ed75552",
      "X": 60,
