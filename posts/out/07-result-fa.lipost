    {
      "$kind": "custombox",
      "Header": "\u06A9\u0650\u06CC \u0647\u0646\u0648\u0632 \u0627\u0633\u062A\u062B\u0646\u0627\u0621 \u067E\u0631\u062A\u0627\u0628 \u06A9\u0646\u06CC\u0645",
      "Body": "",
      "BulletsText": "\u0646\u0642\u0636\u0650 \u06CC\u06A9 \u062B\u0627\u0628\u062A (invariant) \u06CC\u0627 \u0628\u0627\u06AF\n\u062E\u0637\u0627\u06CC \u0648\u0627\u0642\u0639\u0627\u064B \u063A\u06CC\u0631\u0645\u0646\u062A\u0638\u0631\u0647\u0654 I/O \u06CC\u0627 \u0634\u0628\u06A9\u0647\n\u0647\u06CC\u0686\u200C\u062C\u0627\u06CC \u0627\u06CC\u0646\u200C\u062C\u0627 \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0622\u0646 \u0631\u0627 \u0645\u062F\u06CC\u0631\u06CC\u062A \u06A9\u0646\u062F",
