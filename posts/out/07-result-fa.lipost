    {
      "$kind": "custombox",
      "Header": "\u0686\u0631\u0627 Result",
      "Body": "",
      "BulletsText": "\u062E\u0637\u0627\u06CC \u0645\u0648\u0631\u062F\u0627\u0646\u062A\u0638\u0627\u0631 \u062F\u0631 \u0646\u0648\u0639 \u062E\u0631\u0648\u062C\u06CC \u0627\u0633\u062A\n\u0641\u0631\u0627\u062E\u0648\u0627\u0646\u0646\u062F\u0647 \u0628\u0627\u06CC\u062F \u0645\u0648\u0641\u0642\u06CC\u062A \u0648 \u062E\u0637\u0627 \u0631\u0627 \u0645\u062F\u06CC\u0631\u06CC\u062A \u06A9\u0646\u062F\n\u062A\u0631\u06A9\u06CC\u0628 \u0628\u0627 Map / Bind \u0628\u062F\u0648\u0646 \u063A\u0627\u0641\u0644\u06AF\u06CC\u0631\u06CC",
