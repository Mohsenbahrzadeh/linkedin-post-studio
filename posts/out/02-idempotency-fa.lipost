    {
      "$kind": "problem",
      "Header": "\u0628\u062F\u0648\u0646 Key",
      "Intro": "\u0647\u0631 Retry \u06CC\u06A9 \u062F\u0631\u062E\u0648\u0627\u0633\u062A \u06A9\u0627\u0645\u0644\u0627\u064B \u062C\u062F\u06CC\u062F \u062D\u0633\u0627\u0628 \u0645\u06CC\u200C\u0634\u0648\u062F.",
      "RowsText": "POST /orders | \u2192 order #1\nPOST /orders (retry) | \u2192 order #2\nPOST /orders (retry) | \u2192 order #3",
      "BulletsText": "\u06CC\u06A9 \u06A9\u0644\u06CC\u06A9\u060C \u0633\u0647 \u0633\u0641\u0627\u0631\u0634\n\u0647\u06CC\u0686 \u062E\u0637\u0627\u06CC\u06CC \u062F\u06CC\u062F\u0647 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F\n\u0627\u0648\u0644 \u0627\u0632 \u0647\u0645\u0647 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC \u0645\u062A\u0648\u062C\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F",
      "Dir": "Auto",
      "TextScale": 1,
      "Id": "8106369de80e4f9b87524909600e7013",
