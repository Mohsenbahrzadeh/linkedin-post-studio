    },
    {
      "$kind": "quote",
      "Text": "\u0647\u0631 \u0648\u0642\u062A Retry \u0627\u0636\u0627\u0641\u0647 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u062F \u0628\u067E\u0631\u0633\u06CC\u062F: \u0627\u06AF\u0631 \u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0642\u0628\u0644\u06CC \u0648\u0627\u0642\u0639\u0627\u064B \u0645\u0648\u0641\u0642 \u0634\u062F\u0647 \u0628\u0648\u062F \u0686\u0647\u061F",
      "Author": "\u2014 \u0633\u0624\u0627\u0644\u06CC \u06A9\u0647 \u0628\u0627\u06CC\u062F \u0628\u067E\u0631\u0633\u06CC\u062F",
