    {
      "$kind": "flow",
      "NodesText": "Client | POST /orders | \uD83D\uDCF1\n\u0633\u0631\u0648\u0631 | \u0633\u0641\u0627\u0631\u0634 \u062B\u0628\u062A \u0634\u062F \u2705 | \uD83D\uDDC4\uFE0F\n\u0634\u0628\u06A9\u0647 | \u067E\u0627\u0633\u062E \u06AF\u0645 \u0634\u062F\u060C Client \u062F\u0648\u0628\u0627\u0631\u0647 \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F | \u26A0\uFE0F",
