    {
      "$kind": "code",
      "Caption": "ASP.NET Core minimal API",
      "Code": "var existing = await db.IdempotencyRecords.FindAsync(key);\nif (existing is not null)\n    return Results.Json(existing.Response, statusCode: existing.StatusCode);\n\ndb.Orders.Add(order);\ndb.IdempotencyRecords.Add(new(key, 201, order.ToResponse()));\nawait db.SaveChangesAsync();   // one transaction, unique index on Key",
      "Language": "csharp",
      "FontSize": 15,
      "ShowBadge": true,
      "Id": "87f1c7e0b385444a8a0f16ff53ad16dd",
      "X": 60,
      "Y": 724,
      "Width": 960,
      "Height": 179,
      "Z": 7,
      "Rotation": 0,
      "Opacity": 1,
      "IsVisible": true,
      "IsLocked": false
    },
    {
      "$kind": "checklist",
      "ItemsText": "\u062B\u0628\u062A Key \u0648 \u0633\u0641\u0627\u0631\u0634 \u062F\u0631 \u06CC\u06A9 \u062A\u0631\u0627\u06A9\u0646\u0634\nUnique Index \u0631\u0648\u06CC Key\n\u0647\u0645\u0627\u0646 Key \u0628\u0627 \u0628\u062F\u0646\u0647\u0654 \u062F\u06CC\u06AF\u0631 \u2190 \u062E\u0637\u0627\u06CC \u06F4\u06F2\u06F2\n\u0628\u0631\u0627\u06CC Key \u06CC\u06A9 TTL \u0628\u06AF\u0630\u0627\u0631\u06CC\u062F (\u0645\u062B\u0644\u0627\u064B \u06F2\u06F4 \u0633\u0627\u0639\u062A)",
      "Style": "Check",
