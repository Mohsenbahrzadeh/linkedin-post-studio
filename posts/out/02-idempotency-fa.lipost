      "IsLocked": false
    },
    {
      "$kind": "solution",
      "Header": "\u0628\u0627 Idempotency-Key",
      "Intro": "Client \u0628\u0631\u0627\u06CC \u0647\u0645\u0647\u0654 Retry\u0647\u0627\u06CC \u06CC\u06A9 \u0642\u0635\u062F\u060C \u06CC\u06A9 Key \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F.",
      "CodeLinesText": "Idempotency-Key: 7b1c\u2026 | // same key\nOrder #1 | // returned 3\u00D7",
      "BulletsText": "Retry \u0627\u0645\u0646 \u0645\u06CC\u200C\u0634\u0648\u062F\n\u067E\u0627\u0633\u062E \u0630\u062E\u06CC\u0631\u0647\u200C\u0634\u062F\u0647 \u062F\u0648\u0628\u0627\u0631\u0647 \u0628\u0631\u06AF\u0631\u062F\u0627\u0646\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\n\u0628\u0631\u0627\u06CC \u067E\u0631\u062F\u0627\u062E\u062A \u0647\u0645 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F",
      "Dir": "Auto",
      "TextScale": 1,
      "Id": "f8ed52dda046479297dce0de5d357813",
      "X": 588,
