    {
      "$kind": "flow",
      "NodesText": "\u0641\u0631\u0645\u0627\u0646 (Command) | \u0627\u0639\u062A\u0628\u0627\u0631\u0633\u0646\u062C\u06CC \u0648 \u062A\u063A\u06CC\u06CC\u0631 \u0648\u0636\u0639\u06CC\u062A | \u270D\uFE0F\n\u06CC\u06A9 \u067E\u0627\u06CC\u06AF\u0627\u0647\u200C\u062F\u0627\u062F\u0647 | \u0645\u0646\u0628\u0639 \u062D\u0642\u06CC\u0642\u062A | \uD83D\uDDC4\uFE0F\n\u06A9\u0648\u0626\u0631\u06CC (Query) | \u062E\u0648\u0627\u0646\u062F\u0646\u0650 \u0633\u0631\u06CC\u0639 \u0648 \u0634\u06A9\u0644\u200C\u06CC\u0627\u0641\u062A\u0647 | \uD83D\uDD0E",
      "Id": "e7873cb76fe94ebc8182a76dd0e69544",
