    },
    {
      "$kind": "quote",
      "Text": "CQRS \u0641\u0642\u0637 \u062F\u0648 \u0647\u0646\u062F\u0644\u0631 \u0627\u0633\u062A \u2014 \u06CC\u06A9 \u0633\u0645\u062A \u0641\u0631\u0645\u0627\u0646 \u0648 \u06CC\u06A9 \u0633\u0645\u062A \u06A9\u0648\u0626\u0631\u06CC. \u0646\u0647 Event Sourcing \u0644\u0627\u0632\u0645 \u0627\u0633\u062A\u060C \u0646\u0647 \u067E\u0627\u06CC\u06AF\u0627\u0647\u200C\u062F\u0627\u062F\u0647\u0654 \u062F\u0648\u0645.",
      "Author": "\u2014 \u0633\u0627\u062F\u0647 \u0646\u06AF\u0647\u200C\u0634 \u062F\u0627\u0631",
