    {
      "$kind": "code",
      "Caption": "\u0647\u0646\u062F\u0644\u0631 \u0641\u0631\u0645\u0627\u0646",
      "Code": "public async Task Handle(ShipOrder cmd)\n{\n    var order = await db.Orders\n        .FindAsync(cmd.OrderId);\n    order.Ship(cmd.ShippedAt);    // domain rules\n    await db.SaveChangesAsync();  // one transaction\n}",
      "Language": "csharp",
      "FontSize": 14,
      "ShowBadge": true,
      "Id": "abf429b698524fa4a346f4bca2b2ed96",
      "X": 60,
      "Y": 394,
      "Width": 466,
      "Height": 171,
      "Z": 5,
      "Rotation": 0,
      "Opacity": 1,
      "IsVisible": true,
      "IsLocked": false
    },
    {
      "$kind": "code",
      "Caption": "\u0647\u0646\u062F\u0644\u0631 \u06A9\u0648\u0626\u0631\u06CC",
      "Code": "public async Task\u003CList\u003COrderCard\u003E\u003E Handle(\n    GetOrders q) =\u003E\n    await db.Orders\n        .AsNoTracking()\n        .Where(o =\u003E o.Status == q.Status)\n        .Select(o =\u003E new OrderCard(\n            o.Id, o.Customer.Name, o.Total))\n        .ToListAsync();",
      "Language": "csharp",
      "FontSize": 14,
      "ShowBadge": true,
      "Id": "b1f91809f0684ae5b6bbbfdbcda7ad98",
      "X": 554,
      "Y": 386,
      "Width": 466,
      "Height": 187,
      "Z": 6,
      "Rotation": 0,
      "Opacity": 1,
      "IsVisible": true,
      "IsLocked": false
    },
    {
      "$kind": "custombox",
      "Header": "\u06A9\u062C\u0627 \u0628\u0647\u200C\u062F\u0631\u062F \u0645\u06CC\u200C\u062E\u0648\u0631\u062F",
      "Body": "",
      "BulletsText": "\u062E\u0648\u0627\u0646\u062F\u0646 \u0648 \u0646\u0648\u0634\u062A\u0646 \u0645\u0642\u06CC\u0627\u0633 \u0645\u062A\u0641\u0627\u0648\u062A\u06CC \u062F\u0627\u0631\u0646\u062F\n\u0646\u0648\u0634\u062A\u0646\u0650 \u062F\u0627\u0645\u0646\u0647\u200C\u0627\u06CC\u0650 \u067E\u06CC\u0686\u06CC\u062F\u0647\u060C \u062E\u0648\u0627\u0646\u062F\u0646\u0650 \u0633\u0627\u062F\u0647 \u0648 \u0633\u0631\u06CC\u0639\n\u0634\u06A9\u0644 \u062F\u0627\u062F\u0647 \u0628\u0631\u0627\u06CC \u062E\u0648\u0627\u0646\u062F\u0646 \u0648 \u0646\u0648\u0634\u062A\u0646 \u0641\u0631\u0642 \u062F\u0627\u0631\u062F",
      "Marker": "CheckCircle",
      "Glyph": "\u2705",
      "Bg": "#E9F5EC",
