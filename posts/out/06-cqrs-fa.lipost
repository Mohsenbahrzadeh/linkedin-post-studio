    {
      "$kind": "custombox",
      "Header": "\u06A9\u062C\u0627 \u0632\u06CC\u0627\u062F\u06CC \u0627\u0633\u062A",
      "Body": "",
      "BulletsText": "CRUD \u0633\u0627\u062F\u0647 \u0628\u0627 \u06CC\u06A9 \u0634\u06A9\u0644 \u062F\u0627\u062F\u0647\n\u0627\u067E \u06A9\u0648\u0686\u06A9 \u0628\u0627 \u06CC\u06A9 \u062A\u06CC\u0645\n\u0633\u0631\u0627\u063A Event Sourcing \u0631\u0641\u062A\u0646 \u00AB\u0645\u062D\u0636 \u0627\u062D\u062A\u06CC\u0627\u0637\u00BB",
