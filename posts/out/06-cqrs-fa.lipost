    {
      "$kind": "text",
      "Text": "\u06CC\u06A9 \u0645\u062F\u0644 \u0628\u0631\u0627\u06CC \u062A\u063A\u06CC\u06CC\u0631 \u0648\u0636\u0639\u06CC\u062A\u060C \u06CC\u06A9 \u0645\u062F\u0644 \u0628\u0631\u0627\u06CC \u062E\u0648\u0627\u0646\u062F\u0646 \u0622\u0646.",
