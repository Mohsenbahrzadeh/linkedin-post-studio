    {
      "$kind": "section",
      "Text": "\uD83D\uDD0E  \u06A9\u0648\u0626\u0631\u06CC\u200C\u0647\u0627 \u2014 \u062E\u0648\u0627\u0646\u062F\u0646",
      "FontSize": 18,
