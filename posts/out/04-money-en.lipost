    {
      "$kind": "notes",
      "Header": "Rules for money",
      "BulletsText": "decimal for money, double for measurements.\nRounding is a business rule: explicit, in one place, documented.\nWhen splitting, the parts must add up exactly to the total.\nModel Money as its own type, not a plain number.",
      "Dir": "Auto",
      "TextScale": 1,
