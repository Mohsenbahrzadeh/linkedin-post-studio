    {
      "$kind": "code",
      "Caption": "\u062A\u062E\u0635\u06CC\u0635 \u0628\u0627\u0642\u06CC\u200C\u0645\u0627\u0646\u062F\u0647",
      "Code": "public static IReadOnlyList\u003Clong\u003E Allocate(long total, int parts)\n{\n    var share = total / parts;\n    var remainder = (int)(total % parts);\n    return Enumerable.Range(0, parts)\n        .Select(i =\u003E share \u002B (i \u003C remainder ? 1 : 0))\n        .ToList();\n}\n// Allocate(10000, 3) =\u003E [3334, 3333, 3333]   sums to 10000",
      "Language": "csharp",
      "FontSize": 15,
      "ShowBadge": true,
      "Id": "8275ede9067c46f98f0f9c38799778c0",
