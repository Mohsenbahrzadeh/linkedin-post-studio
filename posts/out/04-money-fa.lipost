    {
      "$kind": "solution",
      "Header": "decimal \u0648 \u06CC\u06A9 \u0633\u06CC\u0627\u0633\u062A \u0645\u0634\u062E\u0635",
      "Intro": "\u0627\u0639\u0634\u0627\u0631 \u062F\u0642\u06CC\u0642\u060C \u0631\u064F\u0646\u062F \u06A9\u0631\u062F\u0646 \u0635\u0631\u06CC\u062D \u0648 \u062A\u062E\u0635\u06CC\u0635 \u0628\u0627\u0642\u06CC\u200C\u0645\u0627\u0646\u062F\u0647.",
      "CodeLinesText": "0.1m \u002B 0.2m | // 0.3\nRound(2.5m, 0, AwayFromZero) | // 3",
      "BulletsText": "\u062F\u0631 \u062F\u06CC\u062A\u0627\u0628\u06CC\u0633 decimal(18,2)\n\u06CC\u06A9 \u0642\u0627\u0639\u062F\u0647\u0654 \u0631\u064F\u0646\u062F \u06A9\u0631\u062F\u0646\u060C \u062F\u0631 \u06CC\u06A9 \u062C\u0627\n\u062C\u0645\u0639 \u0627\u062C\u0632\u0627 \u0647\u0645\u06CC\u0634\u0647 \u0628\u0631\u0627\u0628\u0631 \u06A9\u0644 \u0627\u0633\u062A",
