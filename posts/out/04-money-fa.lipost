    {
      "$kind": "problem",
      "Header": "double \u0628\u0631\u0627\u06CC \u067E\u0648\u0644",
      "Intro": "\u0645\u0645\u06CC\u0632 \u0634\u0646\u0627\u0648\u0631 \u062F\u0648\u062F\u0648\u06CC\u06CC \u0628\u06CC\u0634\u062A\u0631 \u06A9\u0633\u0631\u0647\u0627\u06CC \u062F\u0647\u062F\u0647\u06CC \u0631\u0627 \u062F\u0642\u06CC\u0642 \u0646\u0634\u0627\u0646 \u0646\u0645\u06CC\u200C\u062F\u0647\u062F.",
      "RowsText": "0.1 \u002B 0.2 | 0.30000000000000004\n0.1 \u002B 0.2 == 0.3 | False\n100 / 3 \u00D7 3 | 99.99",
      "BulletsText": "\u062E\u0637\u0627\u0647\u0627\u06CC \u0631\u06CC\u0632 \u0627\u0646\u0628\u0627\u0634\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F\n\u0631\u064F\u0646\u062F \u06A9\u0631\u062F\u0646 \u062F\u0631 \u0647\u0631 \u0644\u0627\u06CC\u0647 \u0641\u0631\u0642 \u062F\u0627\u0631\u062F\n\u0628\u0627\u0642\u06CC\u200C\u0645\u0627\u0646\u062F\u0647\u200C\u0647\u0627 \u0628\u06CC\u200C\u0635\u062F\u0627 \u06AF\u0645 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F",
