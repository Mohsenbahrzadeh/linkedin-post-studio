    {
      "$kind": "notes",
      "Header": "\u0642\u0648\u0627\u0639\u062F \u06A9\u0627\u0631 \u0628\u0627 \u067E\u0648\u0644",
      "BulletsText": "decimal \u0628\u0631\u0627\u06CC \u067E\u0648\u0644\u060C double \u0628\u0631\u0627\u06CC \u0627\u0646\u062F\u0627\u0632\u0647\u200C\u06AF\u06CC\u0631\u06CC.\n\u0631\u064F\u0646\u062F \u06A9\u0631\u062F\u0646 \u06CC\u06A9 \u0642\u0627\u0639\u062F\u0647\u0654 \u06A9\u0633\u0628\u200C\u0648\u06A9\u0627\u0631 \u0627\u0633\u062A: \u0635\u0631\u06CC\u062D\u060C \u06CC\u06A9\u062C\u0627 \u0648 \u0645\u0633\u062A\u0646\u062F.\n\u062F\u0631 \u062A\u0642\u0633\u06CC\u0645 \u067E\u0648\u0644\u060C \u062C\u0645\u0639 \u0627\u062C\u0632\u0627 \u0628\u0627\u06CC\u062F \u062F\u0642\u06CC\u0642\u0627\u064B \u0628\u0631\u0627\u0628\u0631 \u06A9\u0644 \u0628\u0627\u0634\u062F.\nMoney \u0631\u0627 \u0628\u0647\u200C\u0639\u0646\u0648\u0627\u0646 \u06CC\u06A9 \u0646\u0648\u0639 \u062C\u062F\u0627\u06AF\u0627\u0646\u0647 \u0645\u062F\u0644 \u06A9\u0646\u06CC\u062F\u060C \u0646\u0647 \u06CC\u06A9 \u0639\u062F\u062F \u0633\u0627\u062F\u0647.",
