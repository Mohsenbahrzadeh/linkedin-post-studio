    },
    {
      "$kind": "solution",
      "Header": "\u06CC\u06A9 \u06A9\u0648\u0626\u0631\u06CC \u0628\u0627 Projection",
      "Intro": "\u0641\u0642\u0637 \u0686\u06CC\u0632\u06CC \u0631\u0627 \u0628\u062E\u0648\u0627\u0646\u06CC\u062F \u06A9\u0647 Endpoint \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u0627\u0646\u062F.",
      "CodeLinesText": "1 query | // not 201\nCPU 95% | // now 18%",
      "BulletsText": "\u0628\u062F\u0648\u0646 Lazy Loading\n\u0628\u062F\u0648\u0646 \u0646\u06CC\u0627\u0632 \u0628\u0647 Scale Up\n\u062A\u0639\u062F\u0627\u062F \u06A9\u0648\u0626\u0631\u06CC \u062F\u0631 \u062A\u0633\u062A Assert \u0645\u06CC\u200C\u0634\u0648\u062F",
