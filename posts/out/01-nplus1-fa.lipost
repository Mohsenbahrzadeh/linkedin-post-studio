    {
      "$kind": "code",
      "Caption": "EF Core",
      "Code": "var orders = await db.Orders\n    .AsNoTracking()\n    .Take(100)\n    .Select(o =\u003E new OrderDto(o.Id, o.Customer.Name, o.Items.Count))\n    .ToListAsync();",
