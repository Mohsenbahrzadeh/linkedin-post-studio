    {
      "$kind": "notes",
      "Header": "\u062F\u0631\u0633\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 \u06AF\u0631\u0641\u062A\u06CC\u0645",
      "BulletsText": "\u062A\u0633\u062A \u0628\u0627 \u062F\u0627\u062F\u0647\u0654 \u06A9\u0645\u060C \u0628\u0627\u06AF\u200C\u0647\u0627\u06CC \u0645\u0642\u06CC\u0627\u0633 \u0631\u0627 \u067E\u0646\u0647\u0627\u0646 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u062A\u0639\u062F\u0627\u062F \u06A9\u0648\u0626\u0631\u06CC \u0631\u0627 \u062F\u0631 Integration Test \u0686\u06A9 \u06A9\u0646\u06CC\u062F.\nLazy Loading \u0631\u0627 \u062E\u0627\u0645\u0648\u0634 \u06A9\u0646\u06CC\u062F. \u0627\u06AF\u0631 \u062F\u0627\u062F\u0647 \u0644\u0627\u0632\u0645 \u0627\u0633\u062A\u060C \u0635\u0631\u06CC\u062D \u0628\u062E\u0648\u0627\u0647\u06CC\u062F\u0634.\n\u062F\u0631 Dev \u0647\u0645\u06CC\u0634\u0647 LogTo \u0631\u0627 \u0631\u0648\u0634\u0646 \u0628\u06AF\u0630\u0627\u0631\u06CC\u062F \u062A\u0627 \u0647\u0631 \u06A9\u0648\u0626\u0631\u06CC \u062F\u06CC\u062F\u0647 \u0634\u0648\u062F.\n\u0642\u0628\u0644 \u0627\u0632 \u062E\u0631\u06CC\u062F \u0633\u062E\u062A\u200C\u0627\u0641\u0632\u0627\u0631\u060C \u0627\u0648\u0644 \u06A9\u0648\u0626\u0631\u06CC\u200C\u0647\u0627 \u0631\u0627 \u0628\u0634\u0645\u0627\u0631\u06CC\u062F.",
