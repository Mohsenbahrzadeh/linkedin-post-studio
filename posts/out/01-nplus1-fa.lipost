    {
      "$kind": "problem",
      "Header": "\u06A9\u062F\u06CC \u06A9\u0647 \u0628\u06CC\u200C\u062E\u0637\u0631 \u0628\u0647 \u0646\u0638\u0631 \u0645\u06CC\u200C\u0631\u0633\u06CC\u062F",
      "Intro": "Lazy Loading \u0628\u0631\u0627\u06CC \u0647\u0631 \u0631\u062F\u06CC\u0641 \u06CC\u06A9 \u06A9\u0648\u0626\u0631\u06CC \u0627\u0636\u0627\u0641\u0647 \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F.",
      "RowsText": "SELECT * FROM Orders | 1\u00D7\nSELECT * FROM Customers | 100\u00D7\nSELECT COUNT(*) FROM Items | 100\u00D7",
      "BulletsText": "\u062F\u0631 Dev \u0628\u0627 \u06F1\u06F0 \u0631\u06A9\u0648\u0631\u062F \u0633\u0631\u06CC\u0639 \u0628\u0648\u062F\n\u0632\u06CC\u0631 \u0628\u0627\u0631 \u0628\u0627 \u06F1\u06F0\u06F0 \u0631\u06A9\u0648\u0631\u062F \u06A9\u0646\u062F \u0634\u062F\n\u0646\u0647 \u062E\u0637\u0627\u060C \u0646\u0647 \u0647\u0634\u062F\u0627\u0631",
      "Dir": "Auto",
      "TextScale": 1,
      "Id": "9c8a3be01c874886b9b95c0bec32c1fd",
