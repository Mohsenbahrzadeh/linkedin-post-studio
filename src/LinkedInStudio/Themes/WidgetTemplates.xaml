<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:inf="clr-namespace:LinkedInStudio.Infrastructure">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesignTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <inf:NullToVisibilityConverter x:Key="NullToVis"/>

    <!-- ============================================================ TITLE -->
    <DataTemplate x:Key="V.TitleItem">
        <TextBlock inf:InlineHost.Source="{Binding Inlines}"
                   FontFamily="{Binding Font}" FontWeight="Bold"
                   FontSize="{Binding FontSize}" TextWrapping="Wrap"
                   FlowDirection="{Binding Flow}" VerticalAlignment="Center"
                   LineStackingStrategy="BlockLineHeight" LineHeight="{Binding FontSize}"/>
    </DataTemplate>

    <!-- ============================================================ BANNER -->
    <DataTemplate x:Key="V.BannerItem">
        <Border CornerRadius="14" Background="{StaticResource B.NavyGradient}" Padding="18,12">
            <DockPanel LastChildFill="True" FlowDirection="{Binding Flow}">
                <Grid DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Ellipse Fill="{StaticResource B.Green}"/>
                    <TextBlock Text="&#128161;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock inf:InlineHost.Source="{Binding Inlines}" FontFamily="{StaticResource F.Fa}"
                           FontSize="{Binding FontSize}" FontWeight="SemiBold" Foreground="White"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================ SECTION LABEL -->
    <DataTemplate x:Key="V.SectionLabelItem">
        <Border CornerRadius="10" Background="{StaticResource B.Navy}" Padding="18,8"
                HorizontalAlignment="{Binding Align}" VerticalAlignment="Center" FlowDirection="{Binding Flow}">
            <TextBlock Text="{Binding Text}" Foreground="White" FontFamily="{StaticResource F.Fa}"
                       FontWeight="Bold" FontSize="{Binding FontSize}"/>
        </Border>
    </DataTemplate>

    <!-- ============================================================ TEXT -->
    <DataTemplate x:Key="V.TextItem">
        <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontWeight="{Binding Weight}"
                   Foreground="{Binding Foreground}" FlowDirection="{Binding Flow}"
                   TextAlignment="{Binding Align}" FontFamily="{Binding Font}"
                   TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DataTemplate>

    <!-- ============================================================ PROBLEM BOX -->
    <DataTemplate x:Key="V.ProblemBoxItem">
        <Border CornerRadius="16" Background="{StaticResource B.RedBg}" BorderBrush="{StaticResource B.RedBorder}"
                BorderThickness="1.5" Padding="16" FlowDirection="{Binding Flow}">
            <StackPanel>
                <StackPanel.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding TextScale}" ScaleY="{Binding TextScale}"/>
                </StackPanel.LayoutTransform>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Grid Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse Fill="{StaticResource B.Red}"/>
                        <TextBlock Text="&#10005;" Foreground="White" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding Header}" Foreground="{StaticResource B.RedDark}" FontWeight="Bold"
                               FontSize="18" FontFamily="{StaticResource F.Fa}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="{Binding Intro}" Foreground="{StaticResource B.NavyText}" FontSize="13"
                           FontFamily="{StaticResource F.Fa}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource B.RedRow}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                <DockPanel LastChildFill="False" FlowDirection="LeftToRight">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Code}" FontFamily="{StaticResource F.Code}"
                                               FontSize="13" Foreground="{StaticResource B.NavyText}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" FontFamily="{StaticResource F.Code}"
                                               FontSize="12" Foreground="{StaticResource B.Muted}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="&#10005;" Foreground="{StaticResource B.Red}"
                                               FontWeight="Bold" Margin="10,0"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Bullets}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2" LastChildFill="True">
                                <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{StaticResource B.Red}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource F.Fa}" FontSize="13"
                                           Foreground="{StaticResource B.NavyText}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================ SOLUTION BOX -->
    <DataTemplate x:Key="V.SolutionBoxItem">
        <Border CornerRadius="16" Background="{StaticResource B.GreenBg}" BorderBrush="{StaticResource B.GreenBorder}"
                BorderThickness="1.5" Padding="16" FlowDirection="{Binding Flow}">
            <StackPanel>
                <StackPanel.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding TextScale}" ScaleY="{Binding TextScale}"/>
                </StackPanel.LayoutTransform>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Grid Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse Fill="{StaticResource B.Green}"/>
                        <TextBlock Text="&#10003;" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding Header}" Foreground="{StaticResource B.GreenDark}" FontWeight="Bold"
                               FontSize="18" FontFamily="{StaticResource F.Fa}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="{Binding Intro}" Foreground="{StaticResource B.NavyText}" FontSize="13"
                           FontFamily="{StaticResource F.Fa}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Border Background="#DCEFE2" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                    <ItemsControl ItemsSource="{Binding CodeLines}" FlowDirection="LeftToRight">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="False" Margin="0,1">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Code}" FontFamily="{StaticResource F.Code}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource B.NavyText}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" FontFamily="{StaticResource F.Code}"
                                               FontSize="12" Foreground="{StaticResource B.GreenDark}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <ItemsControl ItemsSource="{Binding Bullets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="&#10003;" Foreground="{StaticResource B.Green}" FontWeight="Bold"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource F.Fa}" FontSize="13"
                                           Foreground="{StaticResource B.NavyText}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================ CODE BLOCK -->
    <DataTemplate x:Key="V.CodeItem">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                <Border CornerRadius="6" Background="{StaticResource B.Blue}" Padding="6,2" Margin="0,0,8,0"
                        VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                    <TextBlock Text="&lt;/&gt;" Foreground="White" FontFamily="{StaticResource F.Code}" FontSize="12" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="{Binding Caption}" Foreground="{StaticResource B.NavyText}" FontWeight="SemiBold"
                           FontFamily="{StaticResource F.Ui}" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
            <Border CornerRadius="12" Background="{StaticResource B.CodeGradient}" Padding="16">
                <TextBlock inf:InlineHost.Source="{Binding Inlines}" FontFamily="{StaticResource F.Code}"
                           FontSize="{Binding FontSize}" Foreground="{StaticResource B.CodeText}"
                           TextWrapping="NoWrap"/>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================ NOTES BOX -->
    <DataTemplate x:Key="V.NotesItem">
        <Border CornerRadius="16" Background="{StaticResource B.NotesBg}" BorderBrush="{StaticResource B.NotesBorder}"
                BorderThickness="1.5" Padding="16" FlowDirection="{Binding Flow}">
            <StackPanel>
                <StackPanel.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding TextScale}" ScaleY="{Binding TextScale}"/>
                </StackPanel.LayoutTransform>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="&#128203;" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Header}" Foreground="{StaticResource B.Amber}" FontWeight="Bold"
                               FontSize="17" FontFamily="{StaticResource F.Fa}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Bullets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3" LastChildFill="True">
                                <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{StaticResource B.Amber}" Margin="0,7,8,0" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource F.Fa}" FontSize="13"
                                           Foreground="{StaticResource B.NavyText}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================ REFERENCE BOX -->
    <DataTemplate x:Key="V.ReferenceItem">
        <Border CornerRadius="16" Background="{StaticResource B.RefBg}" BorderBrush="{StaticResource B.RefBorder}"
                BorderThickness="1.5" Padding="16">
            <StackPanel>
                <StackPanel.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding TextScale}" ScaleY="{Binding TextScale}"/>
                </StackPanel.LayoutTransform>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="&#128336;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Header}" Foreground="{StaticResource B.NavyText}" FontWeight="Bold"
                               FontSize="16" FontFamily="{StaticResource F.Fa}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Lines}" FlowDirection="LeftToRight">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{StaticResource F.Code}" FontSize="13"
                                       Foreground="{StaticResource B.NavyText}" Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================ FLOW -->
    <DataTemplate x:Key="V.FlowItem">
        <ItemsControl ItemsSource="{Binding Nodes}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Border Background="{Binding Bg}" BorderBrush="{Binding Border}" BorderThickness="1.5"
                                CornerRadius="12" Padding="16,14" Width="212" VerticalAlignment="Stretch">
                            <StackPanel>
                                <Grid Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse Fill="{Binding Accent}"/>
                                    <TextBlock Text="{Binding Glyph}" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextAlignment="Center"
                                           HorizontalAlignment="Center" Foreground="{StaticResource B.NavyText}"
                                           FontFamily="{StaticResource F.Fa}" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Subtitle}" TextAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{StaticResource B.Muted}" FontFamily="{StaticResource F.Fa}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="&#8594;" FontSize="26" Foreground="{StaticResource B.Muted}" Margin="12,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ShowArrow, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- ============================================================ BENEFITS -->
    <DataTemplate x:Key="V.BenefitsItem">
        <ItemsControl ItemsSource="{Binding Cards}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8,0" VerticalAlignment="Center">
                        <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Fill="{Binding Accent}"/>
                            <TextBlock Text="{Binding Glyph}" FontSize="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{StaticResource B.NavyText}" FontFamily="{StaticResource F.Fa}"
                                   FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Desc}" TextAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{StaticResource B.Muted}" FontFamily="{StaticResource F.Fa}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- ============================================================ IMAGE -->
    <DataTemplate x:Key="V.ImageItem">
        <Border CornerRadius="{Binding CornerRadius}" ClipToBounds="True" Background="#EEF1F6"
                BorderBrush="{StaticResource B.PanelBorder}" BorderThickness="1">
            <Grid>
                <Image Source="{Binding Source}" Stretch="{Binding StretchMode}"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Source, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="&#128247;" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource B.Muted}"/>
                    <TextBlock Text="Image" FontFamily="{StaticResource F.Ui}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{StaticResource B.Muted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============================================================ VS BADGE -->
    <DataTemplate x:Key="V.VsBadgeItem">
        <Grid>
            <Ellipse Fill="{StaticResource B.Navy}"/>
            <TextBlock Text="{Binding Text}" Foreground="White" FontWeight="Bold" FontSize="22"
                       FontFamily="{StaticResource F.Ui}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <!-- ============================================================ CUSTOM BOX -->
    <DataTemplate x:Key="V.CustomBoxItem">
        <Border CornerRadius="16" Background="{Binding BgBrush}" BorderBrush="{Binding BorderBrush}"
                BorderThickness="1.5" Padding="16" FlowDirection="{Binding Flow}">
            <StackPanel>
                <StackPanel.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding TextScale}" ScaleY="{Binding TextScale}"/>
                </StackPanel.LayoutTransform>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Grid Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse Fill="{Binding AccentBrush}"/>
                        <TextBlock Text="{Binding Glyph}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding Header}" Foreground="{Binding AccentBrush}" FontWeight="Bold"
                               FontSize="{Binding HeaderSize}" FontFamily="{StaticResource F.Fa}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="{Binding Body}" Visibility="{Binding HasBody}" FontFamily="{StaticResource F.Fa}"
                           FontSize="14" Foreground="{Binding TextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3" LastChildFill="True">
                                <Grid DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Top">
                                    <Ellipse Fill="{Binding MarkerBrush}" Visibility="{Binding ShowCircle, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontWeight="Bold" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource F.Fa}" FontSize="14"
                                           Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================ STAT / KPI -->
    <DataTemplate x:Key="V.StatItem">
        <Border CornerRadius="16" Background="White" BorderBrush="{StaticResource B.Divider}" BorderThickness="1.5" Padding="10"
                FlowDirection="{Binding Flow}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Value}" Foreground="{Binding AccentBrush}" FontWeight="Bold"
                           FontSize="{Binding ValueSize}" FontFamily="{StaticResource F.Ui}" TextAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource B.Muted}" FontSize="15"
                           FontFamily="{StaticResource F.Fa}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================ CHECKLIST -->
    <DataTemplate x:Key="V.ChecklistItem">
        <ItemsControl ItemsSource="{Binding Rows}" VerticalAlignment="Center" FlowDirection="{Binding Flow}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,4" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Marker}" Foreground="{Binding Accent}" FontWeight="Bold"
                                   MinWidth="24" Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Text}" FontFamily="{StaticResource F.Fa}"
                                   Foreground="{StaticResource B.NavyText}" TextWrapping="Wrap"
                                   FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- ============================================================ QUOTE -->
    <DataTemplate x:Key="V.QuoteItem">
        <Border CornerRadius="12" Background="White" BorderBrush="{StaticResource B.Divider}" BorderThickness="1" Padding="0"
                FlowDirection="{Binding Flow}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Width="5" Background="{Binding AccentBrush}"/>
                <StackPanel VerticalAlignment="Center" Margin="18,14">
                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource F.Fa}" FontStyle="Italic"
                               Foreground="{StaticResource B.NavyText}" FontSize="{Binding FontSize}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Author}" FontFamily="{StaticResource F.Fa}" Foreground="{Binding AccentBrush}"
                               FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================ DIVIDER -->
    <DataTemplate x:Key="V.DividerItem">
        <Rectangle Height="{Binding Thickness}" Fill="{Binding LineBrush}" VerticalAlignment="Center"
                   RadiusX="2" RadiusY="2"/>
    </DataTemplate>

    <!-- ============================================================ ARROW -->
    <DataTemplate x:Key="V.ArrowItem">
        <Grid>
            <Rectangle Fill="{Binding LineBrush}" Height="{Binding Thickness}" VerticalAlignment="Center" Margin="0,0,13,0"/>
            <Path Fill="{Binding LineBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M0,0 L14,8 L0,16 Z"/>
        </Grid>
    </DataTemplate>

    <!-- ============================================================ PILL / TAG -->
    <DataTemplate x:Key="V.PillItem">
        <Border CornerRadius="999" Background="{Binding BgBrush}" Padding="16,7" HorizontalAlignment="Center"
                VerticalAlignment="Center" FlowDirection="{Binding Flow}">
            <TextBlock Text="{Binding Text}" Foreground="{Binding FgBrush}" FontWeight="SemiBold"
                       FontFamily="{StaticResource F.Fa}" FontSize="{Binding FontSize}"/>
        </Border>
    </DataTemplate>

    <!-- ============================================================ PROGRESS -->
    <DataTemplate x:Key="V.ProgressItem">
        <StackPanel VerticalAlignment="Center" FlowDirection="{Binding Flow}">
            <DockPanel Margin="2,0,2,6">
                <TextBlock Text="{Binding PercentText}" DockPanel.Dock="Right" Foreground="{Binding AccentBrush}"
                           FontWeight="Bold" FontFamily="{StaticResource F.Ui}"
                           Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource B.NavyText}" FontWeight="SemiBold"
                           FontFamily="{StaticResource F.Fa}"/>
            </DockPanel>
            <Border CornerRadius="999" Background="{Binding TrackBrush}" Height="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding FillWeight}"/>
                        <ColumnDefinition Width="{Binding RestWeight}"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="999" Background="{Binding AccentBrush}"/>
                </Grid>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================ ICON -->
    <DataTemplate x:Key="V.IconItem">
        <Grid>
            <Ellipse Fill="{Binding CircleBrush}" Visibility="{Binding CircleVisibility}"/>
            <TextBlock Text="{Binding Glyph}" Foreground="{Binding ColorBrush}" FontSize="{Binding IconSize}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <!-- ============================================================ SCENE / HEADER GRAPHIC -->
    <DataTemplate x:Key="V.IllustrationItem">
        <ItemsControl ItemsSource="{Binding Nodes}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{Binding Tile}" BorderBrush="{Binding Border}" BorderThickness="1.5"
                                CornerRadius="16" Padding="14" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}"
                                       FontSize="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="&#8594;" FontSize="24" Margin="10,0" VerticalAlignment="Center"
                                   Foreground="{Binding ArrowBrush}"
                                   Visibility="{Binding ShowArrow, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- ============================================================ TABLE -->
    <DataTemplate x:Key="V.TableItem">
        <Border CornerRadius="12" BorderBrush="{StaticResource B.Divider}" BorderThickness="1" ClipToBounds="True"
                FlowDirection="{Binding Flow}" SnapsToDevicePixels="True">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Bg}" BorderBrush="{StaticResource B.Divider}" BorderThickness="0,0,0,1">
                            <ItemsControl ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="{Binding Columns}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Padding="12,8" TextWrapping="Wrap"
                                                   FontFamily="{StaticResource F.Fa}"
                                                   FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   FontWeight="{Binding DataContext.Weight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   Foreground="{Binding DataContext.Fg, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DataTemplate>

    <!-- ============================================================ STEPS (vertical) -->
    <DataTemplate x:Key="V.StepsItem">
        <ItemsControl ItemsSource="{Binding Rows}" VerticalAlignment="Center" FlowDirection="{Binding Flow}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Rectangle Width="2" Fill="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Opacity="0.35"/>
                            <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Accent}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Number}" Foreground="White" FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource B.NavyText}"
                                       FontFamily="{StaticResource F.Fa}" TextWrapping="Wrap"
                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            <TextBlock Text="{Binding Desc}" Foreground="{StaticResource B.Muted}" FontFamily="{StaticResource F.Fa}"
                                       FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- ============================================================ TERMINAL -->
    <DataTemplate x:Key="V.TerminalItem">
        <Border CornerRadius="12" Background="{StaticResource B.CodeGradient}" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#0A1627" Padding="12,8">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Ellipse Width="11" Height="11" Fill="#FF5F56" Margin="0,0,7,0"/>
                            <Ellipse Width="11" Height="11" Fill="#FFBD2E" Margin="0,0,7,0"/>
                            <Ellipse Width="11" Height="11" Fill="#27C93F"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="#9AA6BC" FontFamily="{StaticResource F.Code}"
                                   FontSize="12" HorizontalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <TextBlock inf:InlineHost.Source="{Binding Inlines}" FontFamily="{StaticResource F.Code}"
                           FontSize="{Binding FontSize}" Margin="16,12" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
