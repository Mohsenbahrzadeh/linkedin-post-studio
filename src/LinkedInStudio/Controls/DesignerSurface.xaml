<UserControl x:Class="LinkedInStudio.Controls.DesignerSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:LinkedInStudio.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <inf:InverseBoolConverter x:Key="InvBool"/>

        <!-- transparent full-cover thumb used for moving / selecting -->
        <Style x:Key="MoveThumb" TargetType="Thumb">
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- small square resize handle -->
        <Style x:Key="ResizeThumb" TargetType="Thumb">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="-7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="White" Stroke="#2F80D8" StrokeThickness="1.5" RadiusX="2" RadiusY="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#D7DCE4" FlowDirection="LeftToRight">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="0">
            <Grid Margin="48" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.28" Color="#334155"/>
                </Border.Effect>
                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Value, ElementName=ZoomSlider}"
                                    ScaleY="{Binding Value, ElementName=ZoomSlider}"/>
                </Border.LayoutTransform>
                <Border x:Name="ExportRoot" FlowDirection="LeftToRight"
                        Width="{Binding Doc.CanvasWidth}" Height="{Binding Doc.CanvasHeight}"
                        Background="{Binding Doc.BackgroundBrush}" SnapsToDevicePixels="True">
                    <Grid ClipToBounds="True">
                        <!-- decorative background blobs -->
                        <Canvas>
                            <Ellipse Canvas.Right="-120" Canvas.Top="-160" Width="420" Height="420" Fill="#EAF1FB"/>
                            <Ellipse Canvas.Right="60" Canvas.Top="30" Width="120" Height="120" Fill="#F0F5FC"/>
                        </Canvas>

                        <!-- click-to-deselect catcher -->
                        <Rectangle Fill="Transparent" MouseLeftButtonDown="Background_MouseDown"/>

                        <!-- design items -->
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Background="Transparent" IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    <Setter Property="Width" Value="{Binding Width}"/>
                                    <Setter Property="Height" Value="{Binding Height}"/>
                                    <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
                                    <Setter Property="Visibility" Value="{Binding CanvasVisibility}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- widget visual (rotation + opacity applied here so chrome stays axis-aligned) -->
                                        <ContentControl Content="{Binding}" Opacity="{Binding Opacity}"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        RenderTransform="{Binding RotateTransform}"
                                                        ContentTemplateSelector="{StaticResource WidgetSelector}"/>

                                        <!-- move / select layer -->
                                        <Thumb Style="{StaticResource MoveThumb}" Tag="MOVE"
                                               IsHitTestVisible="{Binding IsLocked, Converter={StaticResource InvBool}}"
                                               DragStarted="Thumb_DragStarted"
                                               DragDelta="Thumb_DragDelta"
                                               DragCompleted="Thumb_DragCompleted"/>

                                        <!-- selection chrome -->
                                        <Grid Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                              IsHitTestVisible="{Binding IsLocked, Converter={StaticResource InvBool}}">
                                            <Rectangle Stroke="#2F80D8" StrokeThickness="1.5" StrokeDashArray="4 2"
                                                       Fill="Transparent" IsHitTestVisible="False"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="TL" Cursor="SizeNWSE"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="T" Cursor="SizeNS"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="TR" Cursor="SizeNESW"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="R" Cursor="SizeWE"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="BR" Cursor="SizeNWSE"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="B" Cursor="SizeNS"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="BL" Cursor="SizeNESW"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"/>
                                            <Thumb Style="{StaticResource ResizeThumb}" Tag="L" Cursor="SizeWE"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"/>

                                            <!-- delete button on the selected element -->
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-16,-16,0"
                                                    Width="28" Height="28" Cursor="Hand" ToolTip="Delete"
                                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid>
                                                            <Ellipse x:Name="c" Fill="#D93A2E"/>
                                                            <Ellipse Stroke="White" StrokeThickness="2"/>
                                                            <TextBlock Text="&#10005;" Foreground="White" FontWeight="Bold" FontSize="13"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="c" Property="Fill" Value="#B0201A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- snapping guides -->
                        <Canvas IsHitTestVisible="False">
                            <Line x:Name="GuideV" Stroke="#E8912A" StrokeThickness="1" StrokeDashArray="4 3"
                                  Visibility="Collapsed" Y1="0" Y2="{Binding Doc.CanvasHeight}"/>
                            <Line x:Name="GuideH" Stroke="#E8912A" StrokeThickness="1" StrokeDashArray="4 3"
                                  Visibility="Collapsed" X1="0" X2="{Binding Doc.CanvasWidth}"/>
                        </Canvas>

                        <!-- fixed footer band -->
                        <Border VerticalAlignment="Bottom" Height="{Binding Doc.FooterHeight}"
                                Background="{StaticResource B.NavyGradient}">
                            <Grid Margin="44,0" FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="106" Height="106" Stroke="#3A567F" StrokeThickness="2"
                                         VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Doc.PhotoSource}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,0,0">
                                    <TextBlock Text="{Binding Doc.Name}" Foreground="White" FontSize="26" FontWeight="Bold"
                                               FontFamily="{StaticResource F.Ui}"/>
                                    <TextBlock Text="{Binding Doc.Role}" Foreground="{StaticResource B.Green}" FontSize="15"
                                               FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Doc.Tagline}" Foreground="#AEB9CC" FontSize="12.5"
                                               Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="380"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource B.Green}" Margin="0,0,10,0">
                                            <TextBlock Text="&#9993;" Foreground="White" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Doc.Email}" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="6" Background="#0A66C2" Margin="0,0,10,0">
                                            <TextBlock Text="in" Foreground="White" FontWeight="Bold" FontSize="15"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Doc.LinkedIn}" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
              </Border>
            </Grid>
        </ScrollViewer>

        <!-- zoom control -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" CornerRadius="8"
                Background="#FFFFFF" Padding="10,6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#128269;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="ZoomSlider" Width="140" Minimum="0.2" Maximum="1.5" Value="0.5"
                        VerticalAlignment="Center" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding Value, ElementName=ZoomSlider, StringFormat={}{0:P0}}"
                           VerticalAlignment="Center" Margin="8,0,0,0" Width="42"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
